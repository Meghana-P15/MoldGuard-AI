MODEL_DIR=ai/models
MOLDING_DATA_PATH=ai/data/modelo.xlsx
ENERGY_DATA_PATH=ai/data/test_dataset.csv
KNOWLEDGE_DIR=knowledge/docs
CORS_ORIGINS=http://localhost:5173

# AWS persistence/model artifacts
USE_DYNAMODB=false
DYNAMODB_TABLE=MoldGuardPredictions
AWS_REGION=ap-south-1
MODEL_S3_BUCKET=
MODEL_S3_PREFIX=models/
REFRESH_MODELS_FROM_S3=false

# Semantic RAG: auto -> Sentence Transformers + FAISS when available,
# then TF-IDF fallback if the embedding model cannot load.
RAG_BACKEND=auto
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# App Runner logs go to CloudWatch Logs. Turn this on after attaching an IAM
# role that allows cloudwatch:PutMetricData.
ENABLE_CLOUDWATCH_METRICS=false
CLOUDWATCH_NAMESPACE=MoldGuardAI
LOG_LEVEL=INFO
