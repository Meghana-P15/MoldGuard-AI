MODEL_DIR=ai/models
KNOWLEDGE_DIR=knowledge

USE_DYNAMODB=false
DYNAMODB_TABLE=MoldGuardPredictions
AWS_REGION=ap-south-1

MODEL_S3_BUCKET=
MODEL_S3_PREFIX=models/
SYNC_MODELS_FROM_S3=false

RAG_EMBEDDER=auto
RAG_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Phase 4 Agentic AI
# local = deterministic local orchestration
# agentcore = FastAPI invokes deployed Amazon Bedrock AgentCore Runtime
AGENT_MODE=local
AGENTCORE_RUNTIME_ARN=
AGENTCORE_QUALIFIER=DEFAULT
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0

CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# Optional local OTEL debugging. AgentCore/CloudWatch tracing is configured at deployment.
MOLDGUARD_OTEL_CONSOLE=false
OTEL_EXPORTER_OTLP_ENDPOINT=
